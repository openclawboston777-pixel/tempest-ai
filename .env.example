# ---- Tempest AI (Ema) — environment variables ----
# Copy this file to ".env" and fill in the real values.
# The real ".env" is git-ignored and must NEVER be committed.

# xAI Grok API key — powers Ema's text chat AND realtime voice.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_VOICE_MODEL=grok-4-realtime

# Shopify — SHOPIFY_STOREFRONT_TOKEN is the only one slice 1 needs.
# The others get filled in when we install the app / build later phases.
# Leave the Storefront token blank to run against the built-in mock catalog.
SHOPIFY_STORE_DOMAIN=151v9c-1d.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Optional: private (server-to-server) Storefront token, used if set.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2025-07
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# AWS (backend deploy — later)
AWS_REGION=eu-north-1
AWS_PROFILE=tempest

# Assistant identity (customer-facing name; "Ema" per spec)
EMA_ASSISTANT_NAME=Ema

# Backend server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Rate limiting for /chat and /voice-token (per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
