# ---- Tempest AI (Ema) — environment variables ----
# Copy this file to ".env" and fill in the real values.
# The real ".env" is git-ignored and must NEVER be committed.

# xAI Grok API key — powers Ema's text chat AND realtime voice.
XAI_API_KEY=

# Shopify — SHOPIFY_STOREFRONT_TOKEN is the only one slice 1 needs.
# The others get filled in when we install the app / build later phases.
SHOPIFY_STORE_DOMAIN=tempestfurnitur.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# AWS (backend deploy — later)
AWS_REGION=eu-north-1
AWS_PROFILE=tempest

# Assistant identity (customer-facing name; "Ema" per spec)
EMA_ASSISTANT_NAME=Ema
