# xAI (OpenAI-compatible). Leave blank to run in MOCK mode.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TEXT_MODEL=grok-4.6

# Shopify Storefront API. Leave blank to run getProducts in MOCK mode.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-07

# Server
PORT=8080
CORS_ORIGIN=*
